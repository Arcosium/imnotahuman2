[Unit]
Description=I'm Not a Human 2 game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/arcosium/projects/imnotahuman2
EnvironmentFile=/home/arcosium/vault/imnotahuman2/.env
Environment=NODE_ENV=production
ExecStart=/home/arcosium/.nvm/versions/node/v24.18.0/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
UMask=0077
MemoryMax=2G

[Install]
WantedBy=default.target
